generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(uuid())
  name               String
  email              String              @unique
  password           String
  role               Role                @default(USER)
  status             String              @default("Active")
  avatarUrl          String?
  refreshToken       String?

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  contact            String?
  emailOtp           String?
  emailOtpExpiry     DateTime?
  isEmailVerified    Boolean             @default(false)
  isPhoneVerified    Boolean             @default(true)
  phone              String              @unique
  phoneOtp           String?
  phoneOtpExpiry     DateTime?
  adoptionRequests   AdoptionRequest[]
  reports            AnimalReport[]
  campaigns          Campaign[]
  campaignVolunteers CampaignVolunteer[]
  comments           Comment[]
  donations          Donation[]
  posts              Post[]
  likes              Like[]
  generalVolunteer   GeneralVolunteer?
  medicalRecords     MedicalRecord[]
  ownedPets          Pet[]               @relation("PetOwner")
  subscriptions      Subscription[]
  partnerId String?
  partner Partner? @relation(fields: [partnerId], references: [id])
  documents          PetDocument[]
}

enum PartnerType {
  NGO
  SHELTER
  VET
  CLINIC
}

enum VerificationStatus {
  PENDING
  VERIFIED
  SUSPENDED
  REJECTED
}

enum RequestType {
  CAMPAIGN
  SUPPORT_REQUEST
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DonationStatus {
  INITIATED
  WEBHOOK_VERIFIED
  REJECTED
  SELF_REPORTED
}

enum CampaignCategory {
  TREATMENT
  FOOD
  SHELTER
  RESCUE
  OTHER
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDING_SOON
  EXPIRED
  COMPLETED
}


model Partner {
  id                     String   @id @default(uuid())

  partnerType            PartnerType

  name                   String

  address                String?
  city                   String?
  state                  String?
  pincode                String?

  lat                    Float?
  lng                    Float?

  phone                  String?@unique
  email                  String?@unique

  verificationStatus     VerificationStatus @default(PENDING)

  razorpayAccountId      String? @unique
  upiId                  String? @unique
  upiQrCode              String?

  commissionEligible     Boolean @default(false)
  customCommissionRate   Decimal @default(0)

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  reports                AnimalReport[]
  campaigns              Campaign[]      // Pending Campaign review
  donations              Donation[]
  medicalRecords         MedicalRecord[]
  pets                   Pet[]
  subscriptions          Subscription[]
  users                  User[]

  @@index([partnerType])
  @@index([verificationStatus])
  @@index([city])
}


model AnimalReport {
  id                String          @id @default(uuid())
  reporterId        String
  status            ReportStatus    @default(REPORTED)
  locationLat       Float
  locationLng       Float
  description       String
  mediaUrls         String[]
  assignedRescuerId String?
  assignedVetId     String?
  
  assignedPartnerId String?

partner Partner? @relation(fields: [assignedPartnerId], references: [id])

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  lastTracked       DateTime?
  rescuerLat        Float?
  rescuerLng        Float?

  reporter          User            @relation(fields: [reporterId], references: [id])
  campaigns         Campaign[]
  medicalRecords    MedicalRecord[]
  pet               Pet?
}

model MedicalRecord {
  id        String       @id @default(uuid())
  reportId  String
  vetId     String
 
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id])
  
  diagnosis String?
  treatment String?
  createdAt DateTime     @default(now())

  report    AnimalReport @relation(fields: [reportId], references: [id])
  vet       User         @relation(fields: [vetId], references: [id])
}

model Pet {
  id               String            @id @default(uuid())
  reportId         String?           @unique

  partnerId        String
  partner Partner @relation(fields: [partnerId], references: [id])

  ownerId          String
  name             String?
  breed            String?
  age              Int?
  gender           String?
  size             String?
  description      String?
  status           String            @default("AVAILABLE")
  createdAt        DateTime          @default(now())
  adoptionRequests AdoptionRequest[]
 
  owner            User              @relation("PetOwner", fields: [ownerId], references: [id])
  report           AnimalReport?     @relation(fields: [reportId], references: [id])
}

model AdoptionRequest {
  id                String         @id @default(uuid())
  petId             String
  userId            String
  status            AdoptionStatus @default(PENDING)
  formDetails       Json
  interviewDate     DateTime?
  interviewTime     String?
  interviewLocation String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  pet               Pet            @relation(fields: [petId], references: [id])
  user              User           @relation(fields: [userId], references: [id])
}

model Campaign {
  id               String @id @default(uuid())

  title            String
  description      String

  goalAmount       Decimal
  raisedAmount     Decimal @default(0)
  progressUpdates  String[]

  requestType      RequestType @default(CAMPAIGN)

  category         CampaignCategory?

  urgency          Urgency?

  animalsImpacted  Int?

  deadline         DateTime?

  partnerId        String

  reportId         String?

  createdBy        String

  status           CampaignStatus @default(DRAFT)

  banner           String?
  image            String?
  location         String?
  purpose          String?

  startDate        DateTime?
  startTime        String?

  theme            String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  partner          Partner @relation(fields: [partnerId], references: [id])

  creator          User @relation(fields: [createdBy], references: [id])

  report           AnimalReport? @relation(fields: [reportId], references: [id])

  volunteers       CampaignVolunteer[]
  donations        Donation[]

  @@index([partnerId])
  @@index([status])
  @@index([deadline])
  @@index([category])
  @@index([requestType])
  @@index([urgency])
}

model Donation {
  id                        String @id @default(uuid())

  userId                    String

  partnerId                 String

  campaignId                String

  grossAmount               Decimal

  razorpayPaymentLinkId     String? @unique

  razorpayPaymentId         String?

  status                    DonationStatus @default(INITIATED)

  platformFee              Decimal @default(0)

  platformFeePercentage    Decimal @default(0)

  netAmount                Decimal

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user                     User @relation(fields: [userId], references: [id])

  partner                  Partner @relation(fields: [partnerId], references: [id])

  campaign                 Campaign @relation(fields: [campaignId], references: [id])

  @@index([userId])
  @@index([partnerId])
  @@index([campaignId])
  @@index([status])
}

model Subscription {
  id                   String           @id @default(uuid())
  userId               String
  partnerId            String
  type                 SubscriptionType
  razorpaySubscriptionId String? @unique

  amount               Float
  status               String           @default("ACTIVE")
  nextCheckout         DateTime
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
 
  partner Partner @relation(fields: [partnerId], references: [id])  
  user                 User             @relation(fields: [userId], references: [id])
}

model GeneralVolunteer {
  id        String   @id @default(uuid())
  userId    String   @unique
  lat       Float?
  lng       Float?
  status    String   @default("APPLIED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model CampaignVolunteer {
  id         String   @id @default(uuid())
  userId     String
  campaignId String
  status     String   @default("CONFIRMED")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, campaignId])
}

model Post {
  id        String   @id @default(uuid())
  caption   String
  postImage String
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User      @relation(fields: [authorId], references: [id])
  likes    Like[]
  comments Comment[]

  isReported Boolean @default(false)
  reportCount Int    @default(0)
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  text      String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model PetDocument {
  id        String   @id @default(uuid())
  userId    String
  name      String
  type      String
  fileData  String   @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  RESCUER
  VET
  ADMIN
  NGO
}

enum ReportStatus {
  REPORTED
  ASSIGNED
  RESCUED
  TREATED
  ADOPTED
}

enum AdoptionStatus {
  PENDING
  INTERVIEW_SCHEDULED
  APPROVED
  REJECTED
}

enum SubscriptionType {
  FOOD
  TREATMENT
  SHELTER
}
