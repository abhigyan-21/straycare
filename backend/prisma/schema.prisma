generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(uuid())
  name               String
  email              String              @unique
  password           String
  role               Role                @default(USER)
  status             String              @default("Active")
  avatarUrl          String?
  refreshToken       String?
  clinicId           String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  contact            String?
  emailOtp           String?
  emailOtpExpiry     DateTime?
  isEmailVerified    Boolean             @default(false)
  isPhoneVerified    Boolean             @default(true)
  phone              String              @unique
  phoneOtp           String?
  phoneOtpExpiry     DateTime?
  adoptionRequests   AdoptionRequest[]
  reports            AnimalReport[]
  campaigns          Campaign[]
  campaignVolunteers CampaignVolunteer[]
  comments           Comment[]
  donations          Donation[]
  posts              FeedPost[]
  generalVolunteer   GeneralVolunteer?
  medicalRecords     MedicalRecord[]
  ownedPets          Pet[]               @relation("PetOwner")
  subscriptions      Subscription[]
  clinic             Clinic?             @relation(fields: [clinicId], references: [id])
  documents          PetDocument[]
}

model Clinic {
  id             String          @id @default(uuid())
  name           String
  address        String?
  city           String?
  contact        String?
  isVerified     Boolean         @default(false)
  createdAt      DateTime        @default(now())
  lat            Float?
  lng            Float?
  reports        AnimalReport[]
  campaigns      Campaign[]
  donations      Donation[]
  medicalRecords MedicalRecord[]
  pets           Pet[]
  subscriptions  Subscription[]
  users          User[]
}

model AnimalReport {
  id                String          @id @default(uuid())
  reporterId        String
  status            ReportStatus    @default(REPORTED)
  locationLat       Float
  locationLng       Float
  description       String
  mediaUrls         String[]
  assignedRescuerId String?
  assignedVetId     String?
  assignedClinicId  String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  lastTracked       DateTime?
  rescuerLat        Float?
  rescuerLng        Float?
  clinic            Clinic?         @relation(fields: [assignedClinicId], references: [id])
  reporter          User            @relation(fields: [reporterId], references: [id])
  campaigns         Campaign[]
  medicalRecords    MedicalRecord[]
  pet               Pet?
}

model MedicalRecord {
  id        String       @id @default(uuid())
  reportId  String
  vetId     String
  clinicId  String
  diagnosis String?
  treatment String?
  createdAt DateTime     @default(now())
  clinic    Clinic       @relation(fields: [clinicId], references: [id])
  report    AnimalReport @relation(fields: [reportId], references: [id])
  vet       User         @relation(fields: [vetId], references: [id])
}

model Pet {
  id               String            @id @default(uuid())
  reportId         String?           @unique
  clinicId         String?
  ownerId          String
  name             String?
  breed            String?
  age              Int?
  gender           String?
  size             String?
  description      String?
  status           String            @default("AVAILABLE")
  createdAt        DateTime          @default(now())
  adoptionRequests AdoptionRequest[]
  clinic           Clinic?           @relation(fields: [clinicId], references: [id])
  owner            User              @relation("PetOwner", fields: [ownerId], references: [id])
  report           AnimalReport?     @relation(fields: [reportId], references: [id])
}

model AdoptionRequest {
  id                String         @id @default(uuid())
  petId             String
  userId            String
  status            AdoptionStatus @default(PENDING)
  formDetails       Json
  interviewDate     DateTime?
  interviewTime     String?
  interviewLocation String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  pet               Pet            @relation(fields: [petId], references: [id])
  user              User           @relation(fields: [userId], references: [id])
}

model Campaign {
  id           String              @id @default(uuid())
  title        String
  description  String
  goalAmount   Float
  raisedAmount Float               @default(0)
  clinicId     String
  reportId     String?
  createdBy    String
  status       CampaignStatus      @default(PENDING)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  banner       String?
  endDate      DateTime?
  image        String?
  location     String?
  purpose      String?
  startDate    DateTime?
  startTime    String?
  theme        String?
  clinic       Clinic              @relation(fields: [clinicId], references: [id])
  creator      User                @relation(fields: [createdBy], references: [id])
  report       AnimalReport?       @relation(fields: [reportId], references: [id])
  volunteers   CampaignVolunteer[]
  donations    Donation[]
}

model Donation {
  id              String       @id @default(uuid())
  userId          String
  amount          Float
  type            DonationType
  clinicId        String?
  campaignId      String?
  paymentIntentId String       @unique
  status          String       @default("PENDING")
  createdAt       DateTime     @default(now())
  campaign        Campaign?    @relation(fields: [campaignId], references: [id])
  clinic          Clinic?      @relation(fields: [clinicId], references: [id])
  user            User         @relation(fields: [userId], references: [id])
}

model Subscription {
  id                   String           @id @default(uuid())
  userId               String
  clinicId             String
  type                 SubscriptionType
  stripeSubscriptionId String           @unique
  amount               Float
  status               String           @default("ACTIVE")
  nextCheckout         DateTime
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  clinic               Clinic           @relation(fields: [clinicId], references: [id])
  user                 User             @relation(fields: [userId], references: [id])
}

model GeneralVolunteer {
  id        String   @id @default(uuid())
  userId    String   @unique
  lat       Float?
  lng       Float?
  status    String   @default("APPLIED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model CampaignVolunteer {
  id         String   @id @default(uuid())
  userId     String
  campaignId String
  status     String   @default("CONFIRMED")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, campaignId])
}

model FeedPost {
  id         String    @id @default(uuid())
  authorId   String
  content    String
  mediaUrls  String[]
  likesCount Int       @default(0)
  status     String    @default("Published")
  reports    Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  comments   Comment[]
  author     User      @relation(fields: [authorId], references: [id])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
  post      FeedPost @relation(fields: [postId], references: [id])
}

model PetDocument {
  id        String   @id @default(uuid())
  userId    String
  name      String
  type      String
  fileData  String   @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  RESCUER
  VET
  ADMIN
  NGO
}

enum ReportStatus {
  REPORTED
  ASSIGNED
  RESCUED
  TREATED
  ADOPTED
}

enum AdoptionStatus {
  PENDING
  INTERVIEW_SCHEDULED
  APPROVED
  REJECTED
}

enum CampaignStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DonationType {
  FOOD
  TREATMENT
  SHELTER
  CAMPAIGN
}

enum SubscriptionType {
  FOOD
  TREATMENT
  SHELTER
}

